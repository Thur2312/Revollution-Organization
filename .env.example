# Supabase — public, safe to expose to the frontend.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase — secret, server-side only (Edge Functions, scripts). Bypasses RLS.
# Never ship this to the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Only needed for local `supabase db push` / `supabase link` against the
# hosted project.
SUPABASE_PROJECT_REF=your-project-ref


# Next.js
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Resend — transactional email. Used to notify a process's cliente_email
# when a status/despacho change is detected. Without these set, that
# notification is silently skipped (see src/lib/email.ts).
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=no-reply@your-domain.com

# Authorizes the Vercel Cron Job (see vercel.json) to call
# /api/jobs/verificar-inpi. Vercel injects this same value as an
# `Authorization: Bearer` header automatically when this env var is set on
# the project — generate any long random string and set it in both places.
CRON_SECRET=a-long-random-string
